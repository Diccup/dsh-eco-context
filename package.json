{
  "name": "dsh-eco-context",
  "version": "1.0.0",
  "description": "dsh-eco-context 1.0.0（17 块积木引擎）",
  "keywords": [
    "dsh",
    "dsh-tui",
    "context-mode",
    "mcp",
    "context-window",
    "code-execution",
    "fts5"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Diccup/dsh-eco-context.git"
  },
  "homepage": "https://github.com/Diccup/dsh-eco-context#readme",
  "bugs": {
    "url": "https://github.com/Diccup/dsh-eco-context/issues"
  },
  "main": "platform/plugin.js",
  "types": "platform/plugin.js",
  "exports": {
    ".": {
      "import": "./platform/plugin.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "platform",
    "ours",
    "skills",
    "engine",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "LICENSING.md",
    "docs",
    "vendor/context-mode/LICENSE",
    "vendor/context-mode/package.json",
    "ASSEMBLY.json"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5",
    "@deepseek-ai/dsh-tools": ">=0.1.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
